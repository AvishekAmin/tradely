# Application Environment (development | production | test)
NODE_ENV=development

# Server Port
PORT=8000

# MongoDB Connection URI (Required)
# Local: mongodb://localhost:27017/tradely
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/tradely?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/tradely

# JWT Authentication (Required; Minimum 32 characters in production)
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars_long
JWT_EXPIRES_IN=7d

# CORS Allowed Client URLs (Separate multiple origins with commas)
FRONTEND_URL=http://localhost:5173
DASHBOARD_URL=http://localhost:5174
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Reverse Proxy Trust Configuration
# 0 (or false) for direct/local deployments; 1 (or true/subnet) when behind Nginx, ALB, Cloudflare
TRUST_PROXY=0

# Payment Gateway (Razorpay TEST MODE)
# Set to 'razorpay' (production/live testing) or 'mock' (deterministic CI/test suites)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_your_test_key_id_here
RAZORPAY_KEY_SECRET=your_test_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
